<Application
    x:Class="LineRename.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#176B50" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#21795D" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#38896F" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#176B50" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E3F1E9" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#F4F6F4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#85D6B3" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#75C5A2" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#65B592" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#85D6B3" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#243D32" />
                    <SolidColorBrush x:Key="AppCardBrush" Color="#D9292C2A" />
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#202421" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
